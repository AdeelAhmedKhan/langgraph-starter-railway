# Copy to .env for local dev. NEVER commit a real .env, and never put a
# real secret in this file. Placeholders only.
# On Railway, set these as service variables instead.

# --- App ---
# Public base URL of the deployed app.
APP_URL=http://localhost:8000
# Port for local dev only. Railway injects $PORT at runtime.
PORT=8000

# --- Database (Postgres 18) ---
# Local: a Postgres you run yourself. Railway: reference variable
# ${{Postgres.DATABASE_URL}} on the app service.
DATABASE_URL=postgresql://langgraph:CHANGE_ME@localhost:5432/langgraph_starter

# --- LLM (optional — the demo graph works without it) ---
# Without OPENAI_API_KEY, drafts are verbatim extracts of the retrieved
# documents, labelled honestly as non-LLM drafts, and retrieval uses
# full-text search instead of vector search. Nothing is faked.
OPENAI_API_KEY=
# Model for answer drafting. Only used when OPENAI_API_KEY is set.
OPENAI_MODEL=gpt-4o-mini
# Embedding model for pgvector. Only used when OPENAI_API_KEY is set.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LangSmith tracing (optional, env-gated) ---
# Without these, tracing is off and /api/health reports
# langsmith: "not_configured". Never a crash, never fake traces.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=langgraph-starter
